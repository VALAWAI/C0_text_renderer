{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "c0-text-renderer": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "i18n": {
        "sourceLocale": "en-001",
        "locales": {
          "en": "src/locale/messages.en.xlf",
          "ca": "src/locale/messages.ca.xlf",
          "es": "src/locale/messages.es.xlf"
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/material-theme.scss", "src/styles.css"],
            "polyfills": ["@angular/localize/init"]
          },
          "configurations": {
            "production": {
              "localize": ["en", "ca", "es"],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "localize": false,
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                }
              ]
            },
            "en": {
              "localize": ["en"]
            },
            "ca": {
              "localize": ["ca"]
            },
            "es": {
              "localize": ["es"]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "c0-text-renderer:build:development,en",
            "host": "0.0.0.0"
          },
          "configurations": {
            "production": {
              "buildTarget": "c0-text-renderer:build:production"
            },
            "development": {
              "buildTarget": "c0-text-renderer:build:development,en"
            },
            "dev": {
              "buildTarget": "c0-text-renderer:build:development"
            },
            "en": {
              "buildTarget": "c0-text-renderer:build:development,en"
            },
            "ca": {
              "buildTarget": "c0-text-renderer:build:development,ca"
            },
            "es": {
              "buildTarget": "c0-text-renderer:build:development,es"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
